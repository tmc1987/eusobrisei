{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "action_audit_batch_request.json",
  "title": "ActionAuditBatchRequest",
  "type": "object",
  "required": ["batch_id", "actions"],
  "properties": {
    "batch_id": { "type": "string", "format": "uuid" },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "action_id", "trigger_event_id", "action_name", "risk_level", "execution_status", "occurred_at", "rollback_possible"
        ],
        "properties": {
          "action_id": { "type": "string", "format": "uuid" },
          "trigger_event_id": { "type": "string", "format": "uuid" },
          "action_name": { "type": "string", "maxLength": 64 },
          "reason": { "type": "string", "maxLength": 512 },
          "risk_level": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
          "pre_state": { "type": "object" },
          "post_state": { "type": "object" },
          "rollback_possible": { "type": "boolean" },
          "rollback_executed": { "type": "boolean" },
          "execution_status": { "type": "string", "enum": ["success", "failed", "partial"] },
          "error_message": { "type": "string", "maxLength": 1024 },
          "occurred_at": { "type": "string", "format": "date-time" },
          "policy_version": { "type": "string", "maxLength": 64 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
